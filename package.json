{
  "name": "nanoclaw",
  "version": "1.2.29",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "unregister": "tsx setup/index.ts --step unregister",
    "auth": "tsx src/whatsapp-auth.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate:sqlite-to-pg": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "test": "vitest run",
    "test:pg": "DATABASE_URL=postgres://nanoclaw:nanoclaw_dev@localhost:5432/nanoclaw_test USE_POSTGRES=true vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "8.5.0",
    "cron-parser": "5.5.0",
    "express": "5.2.1",
    "grammy": "^1.39.3",
    "postgres": "3.4.9",
    "sharp": "^0.33.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "5.0.6",
    "@types/node": "^22.10.0",
    "better-sqlite3": "11.10.0",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
