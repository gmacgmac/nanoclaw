TZ=Europe/London
ANTHROPIC_API_KEY=placeholder
CONTAINER_TIMEOUT=3600000
# Memory nudge interval (number of completed turns between nudges, 0 to disable)
NUDGE_INTERVAL=10

# PostgreSQL connection (set in ~/.config/nanoclaw/secrets.env for credentials)
DATABASE_URL=postgres://nanoclaw:nanoclaw_dev@localhost:5432/nanoclaw
# PostgreSQL is the primary storage layer. Set to false only for legacy/debug.
USE_POSTGRES=true